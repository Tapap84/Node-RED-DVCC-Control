const soc = flow.get('desiredSOC');
const cell = flow.get('desiredCell');

let final;
if (cell === undefined || cell === null) {
    final = (soc === undefined || soc === null) ? 100 : soc;
} else {
    final = Math.min(soc ?? 100, cell);
}

final = Math.max(0, Math.min(100, final));
final = Math.round(final * 10) / 10;

const last = flow.get('lastDVCC');

if (last === final) {
    node.status({
        fill: final === 0 ? "red" : (final >= 50 ? "green" : "yellow"),
        shape: "dot",
        text: "DVCC " + final + " A (unchanged)"
    });
    return null;
}

flow.set('lastDVCC', final);
msg.payload = final;

node.status({
    fill: final === 0 ? "red" : (final >= 50 ? "green" : "yellow"),
    shape: "dot",
    text: "DVCC → " + final + " A"
});

return msg;
